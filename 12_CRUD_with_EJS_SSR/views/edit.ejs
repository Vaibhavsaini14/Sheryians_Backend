<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src = "https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class ="w-full h-full bg-zinc-900 p-10 text-white" >
        <h1 class="text-3xl tracking-tight mb-3" >Update User</h1>
        <form action="/update/<%= user._id %>" method="post" >
            <input class= "px-5 py-3 bg-transparent border-2 border-zinc-800 rounded-lg outline-none" type="text" name="name" placeholder="name" value="<%= user.name %>">
            <input class= "px-5 py-3 bg-transparent border-2 border-zinc-800 rounded-lg outline-none" type="text" name="email" placeholder="email" value="<%= user.email %>">
            <input class= "px-5 py-3 bg-transparent border-2 border-zinc-800 rounded-lg outline-none" type="text" name="imageurl" placeholder="image url" value="<%= user.imageurl %>">
            <input class="px-5 py-3 bg-yellow-500 rounded-lg ml-3 text-black" type="submit" value ="Update User" >
        </form>
        <div class="nav mt-10">
            <a class=" text-xl tracking-tighter text-blue-500" href="/read">Read Users</a>
        </div>
    </div>
</body>
</html>